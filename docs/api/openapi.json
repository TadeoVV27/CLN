            "type": "integer",
            "title": "Id Cotizacion"
          },
          "folio": {
            "type": "string",
            "title": "Folio"
          },
          "cliente": {
            "type": "string",
            "title": "Cliente"
          },
          "vigente": {
            "type": "boolean",
            "title": "Vigente"
          },
          "credito_autorizado": {
            "type": "boolean",
            "title": "Credito Autorizado"
          }
        },
        "type": "object",
        "required": [
          "id_cotizacion",
          "folio",
          "cliente",
          "vigente",
