          },
          "cantidad": {
            "type": "integer",
            "title": "Cantidad"
          },
          "id_pedido": {
            "type": "integer",
            "title": "Id Pedido",
            "default": 501
          }
        },
        "type": "object",
        "required": [
          "producto_id",
          "cantidad"
        ],
        "title": "FaltanteRequest"
      },
      "HTTPValidationError": {
        "properties": {
