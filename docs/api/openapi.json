            "type": "integer",
            "title": "Cliente Id"
          },
          "productos_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Productos Ids"
          },
          "cantidades": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Cantidades"
          }
        },
        "type": "object",
        "required": [
