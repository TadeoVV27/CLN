  <diagram id="k1VcF_bQePEkx0qu4cUk" name="Página 3 - Secuencia excepción">
    <mxGraphModel dx="1022" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CU-03 - Rechazo por cotización vencida o crédito no aprobado\n\nactor Vendedor\n\nparticipant ValidacionApplicationService as ValidacionService\nparticipant ICotizacionRepository as CotizacionRepo\nparticipant Cotizacion\nparticipant Credito\nparticipant IUnitOfWork as UoW\n\nVendedor -&gt; ValidacionService : validarOperacionCredito(cotizacion, datosCredito)\n\nValidacionService -&gt; CotizacionRepo : buscarCotizacionPorId()\nCotizacionRepo --&gt; ValidacionService : cotizacion\n\nValidacionService -&gt; Cotizacion : validarVigencia()\n\nalt Cotizacion vencida\n    Cotizacion --&gt; ValidacionService : vigencia no valida\n    ValidacionService --&gt; Vendedor : operacion detenida por cotizacion vencida\nelse Cotizacion vigente\n    Cotizacion --&gt; ValidacionService : vigencia valida\n    ValidacionService -&gt; Credito : validarAutorizacion()\n\n    alt Credito no aprobado\n        Credito --&gt; ValidacionService : autorizacion rechazada\n        ValidacionService --&gt; Vendedor : operacion detenida por credito no aprobado\n    else Credito aprobado\n        Credito --&gt; ValidacionService : autorizacion valida\n        ValidacionService -&gt; UoW : iniciar()\n        ValidacionService -&gt; UoW : confirmar()\n        ValidacionService --&gt; Vendedor : operacion autorizada\n    end\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wUzSI9AMx6NZv7P0CcfA-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
