        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Arquitectura del Sistema FerreMax\n\nskinparam packageStyle rectangle\nskinparam classAttributeIconSize 0\n\n&#39; =========================\n&#39; APPLICATION LAYER\n&#39; =========================\n\npackage \&quot;Application Layer\&quot; {\n\n    class VentaApplicationService {\n        +procesarVentaMostrador()\n        +procesarVentaEmpresarial()\n    }\n\n    class ValidacionApplicationService {\n        +validarOperacionCredito()\n    }\n\n    class InventarioApplicationService {\n        +gestionarFaltanteInventario()\n    }\n\n    interface IVentaRepository {\n        +guardarVenta()\n        +buscarVentaPorId()\n    }\n\n    interface ICotizacionRepository {\n        +guardarCotizacion()\n        +buscarCotizacionPorId()\n    }\n\n    interface IInventarioRepository {\n        +consultarDisponibilidad()\n        +guardarCambios()\n    }\n\n    interface IPedidoRepository {\n        +guardarPedido()\n        +buscarPedidoPorId()\n    }\n\n    interface IUnitOfWork {\n        +iniciar()\n        +confirmar()\n        +revertir()\n    }\n}\n\n&#39; =========================\n&#39; DOMAIN LAYER\n&#39; =========================\n\npackage \&quot;Domain Layer\&quot; {\n\n    class Venta {\n        -idVenta\n        -estado\n        +confirmar()\n    }\n\n    class Cotizacion {\n        -idCotizacion\n        -vigencia\n        -estado\n        +validarVigencia()\n    }\n\n    class Pedido {\n        -idPedido\n        -estado\n        +marcarParcial()\n    }\n\n    class Inventario {\n        -existencia\n        -comprometido\n        +verificarDisponibilidad()\n        +descontarExistencia()\n    }\n\n    class Credito {\n        -estado\n        +validarAutorizacion()\n    }\n\n    class Transferencia {\n        -idTransferencia\n        -estado\n        +solicitar()\n    }\n}\n\n&#39; =========================\n&#39; INFRASTRUCTURE LAYER\n&#39; =========================\n\npackage \&quot;Infrastructure Layer\&quot; {\n\n    class VentaRepositoryImpl\n    class CotizacionRepositoryImpl\n    class InventarioRepositoryImpl\n    class PedidoRepositoryImpl\n    class UnitOfWorkImpl\n}\n\n&#39; =========================\n&#39; DOMAIN RELATIONSHIPS\n&#39; =========================\n\nVenta --&gt; Pedido\nVenta --&gt; Inventario\nVenta --&gt; Cotizacion\nVenta --&gt; Credito\n\nPedido --&gt; Transferencia\nTransferencia --&gt; Inventario\n\n&#39; =========================\n&#39; APPLICATION -&gt; DOMAIN\n&#39; =========================\n\nVentaApplicationService ..&gt; Venta\nVentaApplicationService ..&gt; Pedido\nVentaApplicationService ..&gt; Inventario\nVentaApplicationService ..&gt; Cotizacion\n\nValidacionApplicationService ..&gt; Cotizacion\nValidacionApplicationService ..&gt; Credito\n\nInventarioApplicationService ..&gt; Inventario\nInventarioApplicationService ..&gt; Pedido\nInventarioApplicationService ..&gt; Transferencia\n\n&#39; =========================\n&#39; APPLICATION -&gt; REPOSITORIES\n&#39; =========================\n\nVentaApplicationService ..&gt; IVentaRepository\nVentaApplicationService ..&gt; IInventarioRepository\nVentaApplicationService ..&gt; IPedidoRepository\nVentaApplicationService ..&gt; ICotizacionRepository\nVentaApplicationService ..&gt; IUnitOfWork\n\nValidacionApplicationService ..&gt; ICotizacionRepository\nValidacionApplicationService ..&gt; IUnitOfWork\n\nInventarioApplicationService ..&gt; IInventarioRepository\nInventarioApplicationService ..&gt; IPedidoRepository\nInventarioApplicationService ..&gt; IUnitOfWork\n\n&#39; =========================\n&#39; INFRASTRUCTURE IMPLEMENTATIONS\n&#39; =========================\n\nVentaRepositoryImpl ..|&gt; IVentaRepository\nCotizacionRepositoryImpl ..|&gt; ICotizacionRepository\nInventarioRepositoryImpl ..|&gt; IInventarioRepository\nPedidoRepositoryImpl ..|&gt; IPedidoRepository\nUnitOfWorkImpl ..|&gt; IUnitOfWork\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vvnKvvKR4lFxNNnMX40_-1">
